# Database connection string (SQLite file URI relative to prisma/ directory)
DATABASE_URL="file:../db/custom.db"

# Biometric service database path (Direct path for read-only template matching)
BIOMETRIC_DATABASE_PATH="C:/path/to/Attendance/db/custom.db"

# Internal service URL where Next.js reaches the FastAPI biometric service
BIOMETRIC_SERVICE_URL="http://127.0.0.1:3010"

# Shared secret token for authenticating calls between Next.js and FastAPI
BIOMETRIC_INTERNAL_TOKEN="your-internal-secret-token"

# Biometric service network settings
BIOMETRIC_HOST="127.0.0.1"
BIOMETRIC_PORT="3010"

# Geolocation verification (fail-closed if true and GPS coordinates absent)
BIOMETRIC_GPS_REQUIRED="false"
BIOMETRIC_GPS_MAX_ACCURACY="150"

# Rate limits (requests per minute)
BIOMETRIC_VERIFY_RATE_LIMIT="90"
BIOMETRIC_ENROLL_RATE_LIMIT="6"
BIOMETRIC_CHALLENGE_RATE_LIMIT="12"
